{
  "expo": {
    "name": "Pokedex",
    "slug": "Pokedex",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pokedex",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-localization",
      "expo-sqlite",
      "@react-native-vector-icons/ionicons",
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
